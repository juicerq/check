{
	"name": "@juicerq/check",
	"version": "0.4.0",
	"description": "Lint rules, shared config, and check runner for juicerq's code standard",
	"author": "juicerq",
	"license": "MIT",
	"homepage": "https://github.com/juicerq/crew/tree/main/check",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/juicerq/crew.git",
		"directory": "check"
	},
	"type": "module",
	"bin": {
		"juicerq-check": "dist/bin/check.js"
	},
	"files": [
		"dist",
		".oxlintrc.json"
	],
	"exports": {
		"./oxlintrc": "./.oxlintrc.json",
		"./plugin": "./dist/plugin.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun ./scripts/build.ts",
		"prepack": "bun run build",
		"test": "node --test \"src/**/*.test.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"knip": "^6.27.0",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^7.0.2001"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	}
}
